<?xml version="1.0" encoding="utf-8"?>
<!-- For a work server running IIS (docs/WEB_APP.md). IIS refuses files whose type it does not
     know (it answers 404), and browsers run ES modules only when served as JavaScript. Other web
     servers ignore this file. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".py" />
      <mimeMap fileExtension=".py" mimeType="text/plain; charset=utf-8" />
      <remove fileExtension=".whl" />
      <mimeMap fileExtension=".whl" mimeType="application/zip" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/plain; charset=utf-8" />
    </staticContent>
  </system.webServer>
</configuration>
